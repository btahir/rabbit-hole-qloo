  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:browser": "playwright test",
    "format": "prettier --write src tests *.ts *.mjs *.json README.md",
    "comparisons": "node --conditions=react-server --env-file-if-exists=.env.local --import tsx scripts/comparisons.ts",
    "db:migrate": "bun --conditions=react-server scripts/migrate.ts"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "4.0.83",
