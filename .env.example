# Required production values; names only. Blank providers select local examples.
QLOO_API_KEY=
ANTHROPIC_API_KEY=
SESSION_SECRET=
APP_ORIGIN=
# Optional legacy share key. Otherwise derived from SESSION_SECRET.
SHARE_TOKEN_SECRET=
# Optional public-demo overrides. See docs/deployment.md for defaults.
ANTHROPIC_MODEL=
QLOO_MODE=
ENTITLEMENT_NAMESPACE=
QLOO_CREDENTIAL_SCOPE=
QLOO_QUOTA_RESETS_AT=
QLOO_ACCESS_VALID_UNTIL=
QLOO_PROJECT_CALL_ALLOWANCE=
QLOO_PROJECT_ALLOCATION_VERIFIED=
QLOO_DAILY_ATTEMPTS=
DAILY_BUDGET_USD=
TOTAL_BUDGET_USD=
INFERENCE_PAUSED=
TRUST_PROXY=
# ShipTiffin injects these; supply local service URLs only for local testing.
DATABASE_URL=
DATABASE_POOL_MAX=
REDIS_URL=
VALKEY_PREFIX=
# Framework/runtime-managed; leave unset locally unless explicitly needed.
# TIFFIN_URL=
# NODE_ENV=
# PORT=
NEXT_TELEMETRY_DISABLED=
# Local development/test only; leave unset on the box.
QLOO_DEV_CACHE_DIR=
ALLOW_MEMORY_STORE=
RABBIT_LIVE_E2E=
RABBIT_SHOTS_DIR=
RABBIT_METRICS=
