# Server-only credentials. Blank keys select the labelled offline example.
QLOO_API_KEY=
ANTHROPIC_API_KEY=
# Optional: live or fixture; defaults to live when a Qloo key is present.
QLOO_MODE=
# Supported model defaults to claude-haiku-5-5.
ANTHROPIC_MODEL=
# Required for public hosting: HTTPS origin and two different random secrets (32+ characters).
APP_ORIGIN=
SESSION_SECRET=
SHARE_TOKEN_SECRET=
# ShipTiffin injects these. Postgres stores state; Valkey caches and enforces Qloo quota.
DATABASE_URL=
DATABASE_POOL_MAX=
REDIS_URL=
VALKEY_PREFIX=
# Optional namespace, default: default. Keep stable across releases.
ENTITLEMENT_NAMESPACE=
# Required for public live Qloo. Confirm the allocation and provision its private KV ledger.
QLOO_CREDENTIAL_SCOPE=
QLOO_QUOTA_RESETS_AT=
QLOO_PROJECT_CALL_ALLOWANCE=
QLOO_PROJECT_ALLOCATION_VERIFIED=
# Optional limits: 150 Qloo attempts/day, $3/day and $25 cumulative model reservations.
QLOO_DAILY_ATTEMPTS=
DAILY_BUDGET_USD=
TOTAL_BUDGET_USD=
# Set to 1 to pause paid inference.
INFERENCE_PAUSED=
# Local development only; optional private response cache directory.
QLOO_DEV_CACHE_DIR=
# Local production smoke test only: 1, with a loopback APP_ORIGIN. Never enable publicly.
ALLOW_MEMORY_STORE=
# Framework/runtime variables; normally leave unset locally, hosting sets them.
# NODE_ENV=
# PORT=
NEXT_TELEMETRY_DISABLED=
# Browser tests only. Live tests require explicit opt-in and spend provider quota.
RABBIT_LIVE_E2E=
RABBIT_SHOTS_DIR=
RABBIT_METRICS=
